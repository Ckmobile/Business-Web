rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---------------- users ----------------
    // Any signed-in user can read profiles (needed for contact search /
    // avatars / online status). Users can only write their own document.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---------------- chats ----------------
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;

      // Allow updates from any existing participant (covers lastMessage,
      // typing, unreadCount, and participant list changes for groups).
      allow update: if signedIn() && request.auth.uid in resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        function isParticipant() {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        allow read: if signedIn() && isParticipant();
        allow create: if signedIn() && isParticipant() && request.resource.data.senderId == request.auth.uid;
        // Allow status/read/delete updates from any chat participant.
        allow update: if signedIn() && isParticipant();
        allow delete: if false;
      }
    }
  }
}
