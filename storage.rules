rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatars: any signed-in user can view; only the owner can upload their own.
    match /avatars/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Chat media: only participants of the corresponding chat may read/write.
    // Requires the matching Firestore chat doc to list the user in `participants`.
    match /chatMedia/{chatId}/{fileName} {
      allow read, write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants
        && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
